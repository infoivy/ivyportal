# Public browser configuration. These values are safe to expose in the built app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_legacy_anon_key

# Server-only configuration for TanStack Start server functions. Never prefix
# this key with VITE_, never commit it, and set it only in local .env / Vercel.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Calendar OAuth (server-only — never prefix with VITE_).
# Create credentials at console.cloud.google.com → APIs & Services → Credentials.
# Add authorized redirect URI: https://portal.ivysalesacademy.com/api/calendar/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_STATE_SECRET=any-random-32-char-string

# Optional integrations. Leave unset to disable the related feature until it is
# configured with a standalone provider.
# CLOSE_API_KEY=
# AI_API_BASE_URL=https://your-ai-provider.example/v1
# AI_API_KEY=
# AI_MODEL=

# Email notifications via Resend (F23). Set in Vercel env vars — never commit.
# Add to Supabase Edge Function secrets too if using the edge function approach.
# RESEND_API_KEY=re_...
